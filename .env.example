# Скопируйте в .env и при необходимости поменяйте значения: cp .env.example .env
# Реальные ключи храните только в .env — он в .gitignore и не попадает в репозиторий.

# --- Порт интерфейса на компьютере (внутри контейнера приложение всегда слушает 8080).
APP_PORT=8080

# --- Языковая модель для разбора запросов: gigachat или openai_compatible.
LLM_PROVIDER=gigachat

# GigaChat: ключ авторизации (Authorization key) из личного кабинета developers.sber.ru.
# Без ключа интерфейс работает в демо-режиме, а «Настоящий агент» сообщит, что модель не настроена.
GIGACHAT_CREDENTIALS=your-gigachat-credentials
# Можно поставить GigaChat-2-Max — точнее разбирает запросы.
GIGACHAT_MODEL=GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Любое OpenAI-совместимое API (LLM_PROVIDER=openai_compatible).
# Пустой URL — стандартный адрес OpenAI.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_BASE_URL=

# --- Ограничения агента.
OPENAI_TIMEOUT_SECONDS=60
AGENT_MAX_SEARCH_CALLS=3
AGENT_MAX_REPAIRS=1

# --- Данные. Демо-мир лежит в data/world.json и уже есть в репозитории.
TRAVEL_DATA_WORLD_PATH=data/world.json

# Погода: MET Norway (без ключа) -> Open-Meteo -> оценка по климату, если сети нет.
MET_NO_ENABLED=true
MET_NO_TIMEOUT_SECONDS=5
MET_NO_USER_AGENT=odin-zapros-hackathon/0.1 https://github.com/ostrovok-hackathon-2026
OPEN_METEO_ENABLED=true
OPEN_METEO_TIMEOUT_SECONDS=2.5
